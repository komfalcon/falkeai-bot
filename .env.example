# Copy these into your hosting Config Vars / Environment Variables. Never commit real values.

# Turso database (libsql://...turso.io for production, or file:local.db for local dev)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

PAIR_PHONE=2349113683395

# Cloudflare Workers AI (10,000 free Neurons/day)
CF_ACCOUNT_ID=your-cloudflare-account-id
AI_API_KEY=your-cloudflare-workers-ai-api-token
AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/your-cloudflare-account-id/ai/v1
AI_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct

# everyone | unsaved   (you can also switch from WhatsApp: "mode unsaved")
REPLY_MODE=everyone

# Optional: minutes to wait for Falcon's reply before FalkeAI takes over (default: 5)
REPLY_WAIT_MINUTES=5
# Optional: minutes FalkeAI stays paused after Falcon replies manually in a chat (default: 120)
TAKEOVER_PAUSE_MINUTES=120

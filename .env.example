# Copy these into your hosting Config Vars / Environment Variables. Never commit real values.

# Turso database (libsql://...turso.io for production, or file:local.db for local dev)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

PAIR_PHONE=2349113683395

# Primary Text Brain: Groq Free Tier (set 1-3 keys; auto-chains Qwen 3.8 27B -> GPT-OSS 120B -> GPT-OSS 20B across keys)
GROQ_API_KEY=gsk_your-primary-groq-key
# GROQ_API_KEY_2=gsk_your-second-groq-key
# GROQ_MODEL=qwen/qwen3.8-27b

# Cloudflare Workers AI (automatic tertiary text fallback + Whisper voice notes + Mistral Vision images)
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-workers-ai-api-token
# Legacy single-provider / custom fallback env vars also work:
# AI_API_KEY=...
# AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/your-cloudflare-account-id/ai/v1
# AI_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# AI_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_FALLBACK_API_KEY=nvapi-...
# AI_FALLBACK_MODEL=meta/llama-3.3-70b-instruct

# everyone | unsaved   (you can also switch from WhatsApp: "mode unsaved")
REPLY_MODE=everyone

# Optional: minutes to wait for Falcon's reply before FalkeAI takes over (default: 5)
REPLY_WAIT_MINUTES=5
# Optional: minutes FalkeAI stays paused after Falcon replies manually in a chat (default: 120)
TAKEOVER_PAUSE_MINUTES=120

# Urgent ring-through-DND alerts via ntfy (use a random unguessable topic name!)
NTFY_TOPIC=falke-urgent-replace-with-random-secret
NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=optional-bearer-token-if-using-private-ntfy

# Daily morning digest hour in Africa/Lagos time (default: 7 = 7:00 AM)
DIGEST_HOUR_LAGOS=7
# Daily voice/image processing cap to stay comfortably inside Cloudflare's 10,000 free Neurons/day (default: 40)
MAX_MEDIA_PER_DAY=40
# Voice note & companion TTS settings (default: "diana" — warm, composed female J.A.R.V.I.S. tone)
# Groq Orpheus female: diana | hannah | autumn  (male: troy | austin | daniel)
# Cloudflare Aura-2-en fallback automatically maps to matching female/male voice (luna | asteria | athena | orion)
TTS_VOICE=diana
MAX_TTS_PER_DAY=25
# Daily SSRF-safe web & social link reader cap (default: 40)
MAX_WEB_READS_PER_DAY=40

# Multi-Account Official Gmail API (OAuth2, scope: gmail.modify; set Consent Screen to "In Production" so refresh tokens never expire)
# Supports GMAIL_REFRESH_TOKEN + GMAIL_REFRESH_TOKEN_2.._20 (with optional GMAIL_LABEL.._20)
# GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
# GMAIL_REFRESH_TOKEN=1//your-primary-refresh-token
# GMAIL_LABEL=Personal
# GMAIL_REFRESH_TOKEN_2=1//your-second-gmail-refresh-token
# GMAIL_LABEL_2=Aurikrex
# GMAIL_REFRESH_TOKEN_6=1//your-sixth-gmail-refresh-token
# GMAIL_LABEL_6=Projects
# Or unlimited accounts via JSON:
# GMAIL_ACCOUNTS_JSON=[{"label":"Personal","refresh_token":"1//..."},{"label":"Work","refresh_token":"1//..."}]

# Optional GitHub Personal Access Token (free) for J.A.R.V.I.S. GitHub repo/PR/notification search
# GITHUB_TOKEN=ghp_your-readonly-github-pat

# Native Kotlin Android Companion Phone Bridge (optional extra signing secret + Heroku public URL hint)
# PHONE_BRIDGE_SECRET=replace-with-32-char-random-secret
# PUBLIC_BASE_URL=https://your-heroku-app.herokuapp.com
